{
  "name": "fixture-tactics-studio",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "data:refresh": "python3 scripts/import-football.py",
    "predev": "node scripts/prepare-reports.mjs && node scripts/prepare-vision.mjs",
    "prebuild": "node scripts/prepare-reports.mjs && node scripts/prepare-vision.mjs",
    "data:season": "python3 scripts/fetch-season.py && node scripts/enrich-season.mjs && node scripts/pack-reports.mjs",
    "postbuild": "node scripts/package-hub.mjs",
    "studio": "node scripts/studio-hub.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "cheerio": "1.1.2",
    "fflate": "^0.8.3",
    "konva": "^10.9.0",
    "lucide-react": "^1.64.0",
    "mediabunny": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
