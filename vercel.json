{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/|vision/|licenses/|icons/|favicon.svg|manifest.webmanifest|sw.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/football.js": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/bang-on-football-studio-v6-review": false
    }
  }
}
